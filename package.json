{
  "name": "hearth",
  "productName": "Hearth",
  "version": "1.0.0",
  "description": "All your Steam, itch.io and other PC games in one Rose Pine library, with playtime tracking and Steam playtime sync.",
  "main": "main.js",
  "author": "phsrp",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "assets": "node scripts/build-assets.js",
    "icon": "electron scripts/make-icon.js",
    "banner": "electron scripts/make-banner.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.phsrp.hearth",
    "productName": "Hearth",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Hearth-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Hearth-Portable-${version}.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "src/**",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "lib",
        "to": ".",
        "filter": [
          "icons.ps1"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.2.0",
    "@tabler/icons": "^3.49.0"
  }
}
